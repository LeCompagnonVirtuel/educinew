# EduCI — Environment Variables

# Site URL (used in emails, redirects, deep links)
NEXT_PUBLIC_SITE_URL="https://educi.live"

# Supabase (client-side, safe to expose)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Supabase (server-side only — NEVER commit real values)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Verification token secret (REQUIRED in production — generate with: openssl rand -hex 32)
VERIFICATION_SECRET="your-random-64-char-hex-secret"

# QR Code signing secret (REQUIRED — generate with: openssl rand -hex 32)
QR_SIGNING_SECRET="your-qr-signing-secret"

# Email configuration (Resend)
RESEND_API_KEY="re_your-resend-api-key"
EMAIL_FROM="EduCI <noreply@educi.live>"

# Token expiry (hours, default 24)
VERIFICATION_TOKEN_EXPIRY_HOURS=24

# Rate limiting
RESEND_RATE_LIMIT_MAX=3
RESEND_RATE_LIMIT_WINDOW_MS=300000

# Payment Gateway (Money Fusion — sole payment provider)
# Encryption key for storing Money Fusion URLs (generate with: openssl rand -hex 32)
GATEWAY_ENCRYPTION_KEY="your-64-char-hex-key"
# Also set CREDENTIALS_ENCRYPTION_KEY if using the payments crypto module
CREDENTIALS_ENCRYPTION_KEY="your-64-char-hex-key"

# AI (DeepSeek + Gemini)
DEEPSEEK_API_KEY="your-deepseek-key"
GEMINI_API_KEY="your-gemini-key"

# Sentry (error tracking)
NEXT_PUBLIC_SENTRY_DSN="https://...@sentry.io/..."
SENTRY_AUTH_TOKEN="sntrys_..."
