{
  "name": "educi-mobile",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write '**/*.{ts,tsx,js,jsx}'",
    "start": "npx expo start",
    "android": "npx expo run:android",
    "ios": "npx expo run:ios",
    "web": "npx expo start --web",
    "start:dev": "npx expo start --dev-client",
    "build:dev": "npx eas build --profile development --platform all",
    "build:preview": "npx eas build --profile preview --platform all",
    "build:prod": "npx eas build --profile production --platform all",
    "build:android:dev": "npx eas build --profile development --platform android",
    "build:android:prod": "npx eas build --profile production --platform android",
    "build:ios:dev": "npx eas build --profile development --platform ios",
    "build:ios:prod": "npx eas build --profile production --platform ios",
    "submit:android:prod": "npx eas submit --platform android --profile production",
    "submit:ios:prod": "npx eas submit --platform ios --profile production",
    "submit:all:prod": "npx eas submit --platform all --profile production",
    "publish:update": "npx eas update --branch production --message \"Production update\"",
    "typecheck": "npx tsc --noEmit"
  },
  "dependencies": {
    "@expo/metro-runtime": "~55.0.11",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.5.2",
    "@react-navigation/native": "^7.1.6",
    "@react-navigation/native-stack": "^7.3.10",
    "@supabase/supabase-js": "^2.108.2",
    "expo": "~55.0.27",
    "expo-av": "^16.0.8",
    "expo-build-properties": "~55.0.15",
    "expo-camera": "~55.0.20",
    "expo-constants": "~55.0.16",
    "expo-dev-client": "~55.0.36",
    "expo-font": "~55.0.8",
    "expo-haptics": "~55.0.15",
    "expo-image-picker": "~55.0.21",
    "expo-linear-gradient": "~55.0.15",
    "expo-location": "~55.1.11",
    "expo-notifications": "~55.0.24",
    "expo-secure-store": "~55.0.15",
    "expo-speech": "~55.0.15",
    "expo-splash-screen": "~55.0.22",
    "expo-status-bar": "~55.0.6",
    "expo-updates": "~55.0.25",
    "react": "19.2.0",
    "react-native": "^0.83.6",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3"
  },
  "devDependencies": {
    "@babel/core": "^7.27.4",
    "@react-native/eslint-config": "^0.86.0",
    "@types/react": "^19.2.10",
    "babel-preset-expo": "~55.0.8",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.1",
    "typescript": "~5.9.2"
  },
  "private": true,
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "expo-av"
        ]
      }
    }
  }
}
